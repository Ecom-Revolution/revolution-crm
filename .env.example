VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Keep false in production. Enables the local UI demo bypass only.
VITE_ENABLE_DEMO_MODE=false

# Supabase Edge Function secrets:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# LOVABLE_API_KEY=your-lovable-ai-key
# GROQ_API_KEY=optional-groq-key
# SERPAPI_KEY=optional-serpapi-key
# HUNTER_API_KEY=optional-hunter-key
# APIFY_API_TOKEN=optional-apify-token
# PAPPERS_API_KEY=optional-pappers-key
# CRON_SECRET=random-secret-used-by-sequence-runner
